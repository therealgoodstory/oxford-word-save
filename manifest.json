{
  "manifest_version": 3,
  "name": "Oxford Word Saver",
  "version": "0.1.0",
  "description": "Убирает рекламу и модальные окна на Oxford Learner's Dictionaries и позволяет сохранять слова вместе с произношением (UK/US).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.oxfordlearnersdictionaries.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.oxfordlearnersdictionaries.com/definition/*"],
      "js": ["common.js", "saver.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Мои слова",
    "default_popup": "words.html?popup=1"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "oxford-word-saver@local",
      "strict_min_version": "127.0"
    }
  }
}
